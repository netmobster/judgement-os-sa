{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/data/**",
              "components/evidence/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/product/**",
              "components/slides/**",
              "components/surfaces/**",
              "ui_kits/keep-yourself-deck/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Caprasimo|Figtree|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Caprasimo, Figtree, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|iconOnly|block|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, iconOnly, block, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|meta|focus|ink|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: kicker, title, meta, focus, ink, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConsoleAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|primary|onClick|key|ref|className|style|children)$/]",
        "message": "<ConsoleAction> doesn't accept that prop. Declared props: label, primary, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|actions|onClose|inline|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, actions, onClose, inline, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceLegend'] > JSXAttribute > JSXIdentifier[name!=/^(?:states|className|style|key|ref|className|style|children)$/]",
        "message": "<EvidenceLegend> doesn't accept that prop. Declared props: states, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:figure|claim|children|state|tagLabel|open|className|style|key|ref|className|style|children)$/]",
        "message": "<EvidenceRow> doesn't accept that prop. Declared props: figure, claim, children, state, tagLabel, open, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|children|key|ref|className|style|children)$/]",
        "message": "<EvidenceTag> doesn't accept that prop. Declared props: state, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|hint|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, id, hint, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ground'] > JSXAttribute > JSXIdentifier[name!=/^(?:ink|key|ref|className|style|children)$/]",
        "message": "<Ground> doesn't accept that prop. Declared props: ink."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:multiline|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: multiline."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|current|onClick|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href, current, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: elevation."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Panel> elevation must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute > JSXIdentifier[name!=/^(?:ink|kicker|date|number|logo|showLogo|title|display|lead|foot|children|key|ref|className|style|children)$/]",
        "message": "<Slide> doesn't accept that prop. Declared props: ink, kicker, date, number, logo, showLogo, title, display, lead, foot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StackRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|verb|items|children|keep|columns|itemsStyle|className|style|key|ref|className|style|children)$/]",
        "message": "<StackRow> doesn't accept that prop. Declared props: label, verb, items, children, keep, columns, itemsStyle, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Table'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Table> doesn't accept that prop. Declared props: columns, rows, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|accent-2|neutral|outline)$/]",
        "message": "<Tag> tone must be one of 'accent' | 'accent-2' | 'neutral' | 'outline'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
